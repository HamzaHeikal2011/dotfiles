#!/bin/bash

# omarchy:summary=Refresh package databases and update the system.
# omarchy:requires-sudo=true

# NOTE: Omarchy's original version of this script overwrote /etc/pacman.conf
# and the mirrorlist with its own dedicated repo/mirrors, keyed by a
# stable/rc/edge release channel. That's Omarchy's own package-repo
# infrastructure and doesn't apply to a personal dotfiles fork, so it's been
# dropped in favor of a plain refresh + update against your normal Arch mirrors.

sudo pacman -Syyu --noconfirm
