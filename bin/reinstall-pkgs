#!/bin/bash

# omarchy:summary=Ensure all packages from your base package list are installed
# omarchy:requires-sudo=true

set -e

# Ensure every package in install/base.packages is installed. Safe to re-run.

mapfile -t packages < <(grep -v '^#' "$DOTFILES_PATH/install/base.packages" | grep -v '^$')
sudo pacman -Syu --noconfirm --needed "${packages[@]}"
