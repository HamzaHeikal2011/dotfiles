#!/bin/bash

# omarchy:summary=Reinstall the dotfiles source directory from git

set -e

# Reset the dotfiles directory to a clean clone of YOUR repo (not upstream Omarchy).
# DOTFILES_REPO must point at your own repo; override via env var if it ever moves.

DOTFILES_REPO="${DOTFILES_REPO:-https://github.com/HamzaHeikal2011/dotfiles.git}"

git clone --depth=1 "$DOTFILES_REPO" ~/.local/share/dotfiles-new >/dev/null
mv "$DOTFILES_PATH" ~/.local/share/dotfiles-old
mv ~/.local/share/dotfiles-new "$DOTFILES_PATH"
